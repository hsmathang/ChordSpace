@article{liMetaphorsMindSources2019,
  title = {Metaphors in the {{Mind}}: {{Sources}} of {{Variation}} in {{Embodied Metaphor}}},
  author = {Li, Heng},
  date = {2019},
  journaltitle = {Metaphor and Symbol},
  volume = {34},
  number = {4},
  doi = {10.1080/10926488.2019.1683960},
  abstract = {Abstract concepts are often embodied through metaphor. For example, we talk about moving through time in metaphorical terms, as if we were moving through space, allowing us to 'look back' on past events. Much of the work on embodied metaphor to date has assumed a single set of universal, shared bodily experiences that motivate our understanding of abstract concepts. This book explores sources of variation in people's experiences of embodied metaphor, including, for example, the shape and size of one's body, one's age, gender, state of mind, physical or linguistic impairments, personality, ideology, political stance, religious beliefs, and linguistic background. It focuses on the ways in which people's experiences of metaphor fluctuate over time within a single communicative event or across a lifetime. Combining theoretical argument with findings from new studies, Littlemore analyses sources of variation in embodied metaphor and provides a deeper understanding of the nature of embodied metaphor itself. Cover; Half-title; Title page; Copyright information; Dedication; Contents; List of Figures; Preface; Acknowledgements; 1 'I Am Trying to Climb Everest in Flip-Flops.': What Is Embodied Metaphor and Where Does It Come From?; 1.1 Introduction; 1.2 Embodied Cognition; Embodied Cognition and the '4E' Approach; 1.3 Embodied Metaphor; Embodied Metaphor and the '4E' Approach; 1.4 Where Do Embodied Primary Metaphors Come From?; 1.5 Conclusion; 2 'Would You Prefer a Pencil or an Antiseptic Wipe?': What Evidence Is There for Embodied Metaphor and Why Is It Important to Consider This Variation? 2.1 Introduction2.2 Evidence from Behavioural Studies; Moving Forwards in Time is Moving Forwards in Space; More/Positive/Powerful Is Up and Less/Negative/Lacking Power Is Down; Affection Is Warmth; Morality Is Cleanliness; Importance Is Weight; Difficulty and Guilt Are Weight; Positive and Negative Affect Are Lightness and Darkness; Resemblance Is Proximity; Fictive Motion; Embodied Idioms; Limitations of Behavioural Evidence; 2.3 Evidence from Neurological Studies; Limitations of the Neurological Evidence; 2.4 Evidence from Naturally Occurring Data; Linguistic Evidence Visual Evidence from Film, Advertising and ArtGestural Evidence; 'Spoken' Gestural Studies; 2.5 Variation in Embodied Metaphor; 2.6 Outline of the Rest of the Book; 3 'I'm Running on This Soapy Conveyor Belt with People Throwing Wet Sponges at Me.': Which Metaphors Are Embodied and When?; 3.1 Introduction; 3.2 Intrinsic and Co-Textual Features That Render Metaphors More Likely to Evoke Sensorimotor Activation; Novelty; Emotion; Motion; Perspective; Signalling and Foregrounding 3.3 Contextual Factors That May Render Metaphors More Likely to Evoke Sensorimotor Responses: The Influence of Genre and RegisterGenre; Discourse-Community; Communicative Purpose; Staging; Register; 3.4 Conclusion; 4 'This One Sounds Like A Bell and This One Sounds Like When You're Dead.': Age, and the Developmental Nature of Embodied Metaphor; 4.1 Introduction; 4.2 The Development of Embodied Metaphor Comprehension in Infants and Children; 4.3 Metaphors That Are Particularly Strong in Infancy; Personification Metaphor; Cross-sensory Metaphor; Generalised Magnitude Representation 4.4 Maths, Music and Metaphor: A Comparison of Young Children's Representations of Number, Valence, Music and Time with Those of AdultsTask 1: Numbers (Paper on Vertical Frame); Task 2: Time (Paper on Vertical Frame); Task 3: Valence (Paper on Vertical Frame); Task 4: Pitch (Paper on Vertical Frame); Task 5: Staccato and Legato (Paper on Table); Task 6: Major and Minor Chords (Paper on Table); Findings; Findings with Respect to Number; Findings with Respect to Time; Findings with Respect to Valence; Findings with Respect to Pitch; Findings with Respect to Legato and Staccato}
}

@article{lopezAUGMENTEDNETROMANNUMERAL2021,
  title = {{{AUGMENTEDNET}}: {{A ROMAN NUMERAL ANALYSIS NETWORK WITH SYNTHETIC TRAINING EXAMPLES AND ADDITIONAL TONAL TASKS}}},
  author = {López, Néstor Nápoles and Gotham, Mark and Fujinaga, Ichiro},
  date = {2021},
  abstract = {AugmentedNet is a new convolutional recurrent neural network for predicting Roman numeral labels. The network architecture is characterized by a separate convolutional block for bass and chromagram inputs. This layout is further enhanced by using synthetic training examples for data augmentation, and a greater number of tonal tasks to solve simultaneously via multitask learning. This paper reports the improved performance achieved by combining these ideas. The additional tonal tasks strengthen the shared representation learned through multitask learning. The synthetic examples, in turn, complement key transposition, which is often the only technique used for data augmentation in similar problems related to tonal music. The name ‘AugmentedNet’ speaks to the increased number of both training examples and tonal tasks. We report on tests across six relevant and publicly available datasets: ABC, BPS, HaydnSun, TAVERN, When-in-Rome, and WTC. In our tests, our model outperforms recent methods of functional harmony, such as other convolutional neural networks and Transformer-based models. Finally, we show a new method for reconstructing the full Roman numeral label, based on common Roman numeral classes, which leads to better results compared to previous methods.},
  langid = {english},
  file = {files/79/López et al. - 2021 - AUGMENTEDNET A ROMAN NUMERAL ANALYSIS NETWORK WITH SYNTHETIC TRAINING EXAMPLES AND ADDITIONAL TONAL.pdf}
}

@report{lozanoGenerationPopRockChord2009,
  title = {Generation of {{Pop-Rock Chord Sequences Using Genetic Algorithms}} and {{Variable Neighborhood Search}}},
  author = {Lozano, Leonardo and Medaglia, Andrés and Velasco, Nubia},
  date = {2009},
  volume = {5484},
  pages = {573--578},
  abstract = {This work proposes a utility function that measures: 1) the vertical relation between notes in a melody and chords in a sequence, and 2) the horizontal relation among chords. This utility function is embedded in a procedure that combines a Genetic Algorithm (GA) with a Variable Neighborhood Search (VNS) to automatically generate style-based chord sequences. The two-step algorithm is tested in ten popular songs, achieving accompaniments that match closely those of the original versions.},
  keywords = {Genetic Algorithms,Musical harmony,Variable Neighborhood Search}
}

