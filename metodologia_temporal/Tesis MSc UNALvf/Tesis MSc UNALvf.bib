  date = {2014},
  journaltitle = {ProQuest Dissertations and Theses},
  abstract = {This dissertation presents a theory of the transformational analysis of music. It explores ways in which musical transformation, mathematics, and meaning can be integrated, through a critical reading of David Lewin's and several contemporary philosophers' works on language, system, and poetic experience.    As an attempt to move away from the prevalent structuralist paradigm of music analysis, the theory resituates musical transformations at the dynamic intersection between a minimal cognitive principle (recursivity) and a poetic agency (the attitudinal i). Recursivity is the structural common denominator of the various background structures underpinning musical experiences. The attitudinal i exposes and marks out the transformational potential of every interval that constitutes a music-analytical expression appearing in the transformational analysis of music.    The dissertation also delves into the characteristic role of mathematics within the transformational analysis of music. Drawing on the philosopher Alain Badiou's recent works on mathematics and art, it examines how and in what sense mathematical group theory can become a means to grasp, and express poetically, an unmediated (or minimally mediated) relationship between human intelligence and musical matter. Against the assumption that in music analysis mathematical relations and poetic expressions are forever in the relationship of discursive doubles, the dissertation argues that mathematical expressions, or "mathemes," in the transformational analysis of music are in themselves a poetic expression of a perceptual reality, and that music analysis is, and should be, a kind of poetry.}
}

@article{chuanContextConceptExploring2020,
  title = {From Context to Concept: Exploring Semantic Relationships in Music with Word2vec},
  author = {Chuan, Ching Hua and Agres, Kat and Herremans, Dorien},
  date = {2020},
  journaltitle = {Neural Computing and Applications},
  volume = {32},
  number = {4},
  doi = {10.1007/s00521-018-3923-1},
  abstract = {We explore the potential of a popular distributional semantics vector space model, word2vec, for capturing meaningful relationships in ecological (complex polyphonic) music. More precisely, the skip-gram version of word2vec is used to model slices of music from a large corpus spanning eight musical genres. In this newly learned vector space, a metric based on cosine distance is able to distinguish between functional chord relationships, as well as harmonic associations in the music. Evidence, based on cosine distance between chord-pair vectors, suggests that an implicit circle-of-fifths exists in the vector space. In addition, a comparison between pieces in different keys reveals that key relationships are represented in word2vec space. These results suggest that the newly learned embedded vector representation does in fact capture tonal and harmonic characteristics of music, without receiving explicit information about the musical content of the constituent slices. In order to investigate whether proximity in the discovered space of embeddings is indicative of ‘semantically-related’ slices, we explore a music generation task, by automatically replacing existing slices from a given piece of music with new slices. We propose an algorithm to find substitute slices based on spatial proximity and the pitch class distribution inferred in the chosen subspace. The results indicate that the size of the subspace used has a significant effect on whether slices belonging to the same key are selected. In sum, the proposed word2vec model is able to learn music-vector embeddings that capture meaningful tonal and harmonic relationships in music, thereby providing a useful tool for exploring musical properties and comparisons across pieces, as a potential input representation for deep learning models, and as a music generation device.}
}

@article{ciubotaruExploringChordEmbedding,
  title = {Exploring Chord Embedding Spaces between Musical Composers and Eras},
  author = {Ciubotaru, Adina and Kliavinek, Sergei and Gruneau, Marcus and Moss, Dr Fabian and McLeod, Dr Andrew},
  abstract = {In recent years, natural language processing algorithms have become more sophisticated and powerful due to the development of deep neural networks. In this paper we have decided to exploit these powerful tools in order to generate an embedding space of musical chords using two sets of annotated corpora, containing musical scores from different eras. The resulting embedding spaces were visualized in different ways and show that the trained models managed to catch fundamental similarities between different chords. The possibility of predicting subsequent chords in context using various word representation models and a recurrent neural network was also investigated. It is shown that even using a small neural network, it is possible to achieve good results.},
  langid = {english},
  file = {files/334/Ciubotaru et al. - Exploring chord embedding spaces between musical composers and eras.pdf}
}

@article{cookHarmonyPerceptionHarmoniousness2009,
  title = {Harmony {{Perception}}: {{Harmoniousness}} Is {{More Than}} the {{Sum}} of {{Interval Consonance}}},
  shorttitle = {Harmony {{Perception}}},
  author = {Cook, Norman D.},
  date = {2009-09-01},
  journaltitle = {Music Perception},
  volume = {27},
  number = {1},
  pages = {25--42},
  issn = {0730-7829, 1533-8312},
  doi = {10.1525/mp.2009.27.1.25},
  url = {https://online.ucpress.edu/mp/article/27/1/25/62412/Harmony-Perception-Harmoniousness-is-More-Than-the},
  urldate = {2026-02-11},
  abstract = {ATTEMPTS TO EXPLAIN HARMONY PERCEPTION SINCE Helmholtz (1877/1954) have relied primarily on psychoacoustical models of the dissonance among the partials of chord tones. Those models are successful in explaining interval perception and the interval structure of common scales, but do not account for even the basics of triadic harmony. By introducing a 3-tone "tension" factor, I show how the sonority of the triads of diatonic music can be explained.Moreover, the relative size of the intervals among the partials in triads determines the major/minor modality of chords: major chords have a predominance of larger lower intervals, while minor chords have a predominance of smaller lower intervals. Finally, by invoking the "frequency code" known from linguistics and ethology, the positive/negative valence of the major/minor chords is shown to have an acoustical basis. I conclude that the perception of harmony can be explained by the acoustical structure of triads, without invoking cultural factors.},
  langid = {english},
  file = {files/171/Cook - 2009 - Harmony Perception Harmoniousness is More Than the Sum of Interval Consonance.pdf;files/179/Cook - 2009 - Harmony Perception Harmoniousness is More Than the Sum of Interval Consonance.pdf}
}

@article{cookPsychophysicsHarmonyPerception2006,
  title = {The {{Psychophysics}} of {{Harmony Perception}}: {{Harmony}} Is a {{Three-Tone Phenomenon}}},
  shorttitle = {The {{Psychophysics}} of {{Harmony Perception}}},
  author = {Cook, Norman D. and Fujisawa, Takashi X.},
  date = {2006},
  journaltitle = {Empirical Musicology Review},
  shortjournal = {Empirical Musicology Review},
  volume = {1},
  number = {2},
  pages = {106--126},
  issn = {15595749},
  doi = {10.18061/1811/24080},
  url = {https://kb.osu.edu/dspace/handle/1811/24080},
  urldate = {2026-02-11},
  abstract = {In line with musical “common sense” (but contrary to the century-old tradition of musical psychophysics), we show that harmony is an inherently three-tone phenomenon. Previous attempts at explaining the affective response to major/minor chords and resolved/unresolved chords on the basis of the summation of interval dissonance have been notably unsuccessful, but consideration of the relative size of the intervals contained in triads leads directly to solutions to these historical problems. At the heart of our model is Leonard Meyer’s idea from 1956 concerning “intervallic equidistance” – i.e., the perception of “tension” inherent to any three-tone combination that has two intervals of equivalent size (e.g., the augmented chord). By including the effects of the upper partials, a psychophysical explanation of the perceived sonority of the triads (major{$>$}minor{$>$}diminished{$>$}augmented) and the affective valence of major and minor chords is easily achieved. We conclude that the perceptual regularities of traditional diatonic harmony are neither due to the summation of interval effects nor simply arbitrary, learned cultural artifacts, but rather that harmony has a psychophysical basis dependent on three-tone combinations.},
  langid = {english},
  file = {files/173/Cook y Fujisawa - 2006 - The Psychophysics of Harmony Perception Harmony is a Three-Tone Phenomenon.pdf}
}

