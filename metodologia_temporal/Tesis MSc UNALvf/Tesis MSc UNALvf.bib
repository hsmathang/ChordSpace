  volume = {56},
  number = {1},
  doi = {10.1215/00222909-1546958},
  abstract = {This article relates two categories of music-theoretical graphs, in which points represent notes and chords, respectively. It unifies previous work by Brower, Callender, Cohn, Douthett, Gollin, O'Connell, Quinn, Steinbach, and myself, while also introducing new models of voice-leading structure-including a three-note octahedral Tonnetz and tetrahedral models of four-note diatonic and chromatic chords. © 2012 by Yale University.}
