@article{plotkinChordProximityParsimony2019,
  title = {Chord {{Proximity}}, {{Parsimony}}, and {{Analysis}} with {{Filtered Point-Symmetry}}},
  author = {Plotkin, Richard},
  date = {2019-07},
  journaltitle = {Music Theory Online},
  shortjournal = {MTO},
