@book{zhangChordRecognitionUsing2010,
  title = {Chord Recognition Using Ensemble Voicing Constraints},
  author = {Zhang, Xinglin},
  date = {2010},
  series = {{{ProQuest Dissertations}} and {{Theses}}},
  abstract = {Many applications in Music Information Retrieval such as music similarity computation and structural music segmentation require high-level analysis of the music piece in which the harmonic structure plays an important role. Additionally, in Western music, the harmonic structure can often be well illustrated by the chord information in terms of chord sequence and chord voicings. Chord sequence analysis and detection from raw audio attracts many researchers; whereas chord voicings, which are more complicated but more useful under certain circumstances, are seldom studied.    This thesis focuses on the analysis of chord voicings, presenting a technique for disambiguation of chords based on a priori knowledge of probabilities of voicings of the chord in a specific musical medium. The main motivating example is guitar chord recognition, where the physical layout and structure of the instrument, along with human physical and temporal constraints, make certain chord voicings and chord sequences more likely than others, and some even impossible.    To represent chords, pitch classes are first extracted, chord candidates are then recognized using pattern recognition techniques. This thesis also does chord sequence analysis to reinforce accuracy of individual chord estimations. The chord information is analyzed using an array of voicing vectors indicating likelihood for chord voicings based on the constraints of the instrument.    The contribution of this thesis to the music information retrieval community is that chord voicing information is extracted in addition to chord type, giving a more meaningful description of the harmonic structure. Although guitar chords are the main target in this thesis, the method of voicing constraints can be extended to the instrument that presents constraints due to different facts such as the physical layout.},
  issue = {February}
}
